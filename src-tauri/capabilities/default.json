{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for Burrow's popover and dashboard",
  "windows": ["popover", "dashboard"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open"
  ]
}
