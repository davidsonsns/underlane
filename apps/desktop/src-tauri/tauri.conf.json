{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Underlane",
  "mainBinaryName": "Underlane",
  "version": "0.3.0",
  "identifier": "app.underlane",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Run cloudflared tunnels from the menu bar",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.3",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBMzJBRUI3OEZFOEY1NTgKUldSWTllaVB0NjR5bXBPODJrUnJXdHB0RXhESUZ6MldxTEswYmhkZ0ltK3pIeVlyZmRncnVES3gK",
      "endpoints": [
        "https://github.com/davidsonsns/underlane/releases/latest/download/latest.json"
      ]
    }
  }
}
