{
  "name": "underlane-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "fallow --fail-on-issues",
    "build": "pnpm --filter underlane build",
    "check": "pnpm --filter underlane check",
    "dev": "pnpm --filter underlane dev",
    "fix": "ultracite fix",
    "lint": "ultracite check",
    "tauri": "pnpm --filter underlane tauri",
    "test": "pnpm --filter underlane test && pnpm run test:scripts",
    "test:scripts": "node --test scripts/lib/*.test.mjs e2e/lib/*.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "fallow": "^3.33.1",
    "playwright": "^1.64.1",
    "ultracite": "^8.0.1"
  },
  "packageManager": "pnpm@10.27.0"
}
