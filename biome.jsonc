{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/svelte"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "apps/desktop/src/**",
      "apps/web/src/styles/**",
      "apps/web/scripts/**",
      "e2e/**",
      "scripts/**",
      "*.{ts,js,json,jsonc,html}",
      "apps/*/*.{ts,js,json,jsonc,html}",
      "!!apps/desktop/src/lib/components/ui"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/*.svelte"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["PascalCase", "kebab-case"]
              }
            }
          }
        }
      }
    }
  ]
}
